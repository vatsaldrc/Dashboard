// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "mysql"
    url      = env("DATABASE_URL")
}

enum Role {
    ADMIN
    USER
}

model User {
    id        Int      @id @default(autoincrement())
    email     String   @unique
    name      String?
    password  String
    role      Role     @default(USER)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model BotpressApiAnalytics {
    id                 Int     @id @default(autoincrement())
    botId              String  @map("bot_id")
    date               DateTime @db.Date
    returningUsers     Int     @default(0) @map("returning_users")
    newUsers           Int     @default(0) @map("new_users")
    sessions           Int     @default(0)
    totalMessages      Int     @default(0) @map("total_messages")
    userMessages       Int     @default(0) @map("user_messages")
    botMessages        Int     @default(0) @map("bot_messages")
    events             Int     @default(0)
    eventTypes         Json?   @map("event_types")
    llmCalls           Int     @default(0) @map("llm_calls")
    llmErrors          Int     @default(0) @map("llm_errors")
    llmInputTokens     Int     @default(0) @map("llm_input_tokens")
    llmOutputTokens    Int     @default(0) @map("llm_output_tokens")
    llmLatencyMean     Float?  @map("llm_latency_mean")
    llmCostSum         Float?  @default(0) @map("llm_cost_sum")
    llmCostMean        Float?  @map("llm_cost_mean")
    hourlyRecordsCount Int     @default(0) @map("hourly_records_count")
    syncDate           DateTime @map("sync_date") @db.Date

    @@index([botId])
    @@index([date])
    @@index([syncDate])
    @@map("botpress_api_analytics")
}

model ChatbotAnalytics {
    id                        Int     @id @default(autoincrement())
    botId                     String  @map("bot_id")
    conversationId            String  @map("conversation_id") @db.VarChar(255)
    date                      DateTime @db.Date
    integration               String  @db.VarChar(255)
    totalMessages             Int     @default(0) @map("total_messages")
    userMessages              Int     @default(0) @map("user_messages")
    botMessages               Int     @default(0) @map("bot_messages")
    avgMessageLength          Float?  @map("avg_message_length")
    sentiment                 String? @db.VarChar(20)
    keywords                  Json?   @map("keywords")
    tags                      Json?   @map("tags")
    summary                   String? @db.Text
    personalContactRequested  Int     @default(0) @map("personal_contact_requested")
    requestedContactChannel   String? @map("requested_contact_channel") @db.VarChar(50)
    customerType              String? @map("customer_type") @db.VarChar(50)
    customerRegion            String? @map("customer_region") @db.VarChar(50)
    syncDate                  DateTime @map("sync_date") @db.Date

    @@index([botId])
    @@index([date])
    @@index([integration])
    @@map("chatbot_analytics")
}

model PostalMP {
    postalCode  String  @id @db.VarChar(10) @map("Postal Code")
    mp          String  @db.VarChar(50)

    @@map("postal_mp")
}

model Leads {
    id                    Int     @id @default(autoincrement())
    fullName              String? @map("full_name") @db.VarChar(255)
    email                 String? @db.VarChar(255)
    phone                 String? @db.VarChar(15)
    postalCode            String? @map("postal_code") @db.VarChar(20)
    company               String? @db.VarChar(255)
    customerType          String? @map("customer_type") @db.VarChar(100)
    conversationSummary   String? @map("conversation_summary") @db.Text
    status                Int?
    createdAt             DateTime? @default(now()) @map("created_at")
    updatedAt             DateTime? @updatedAt @map("updated_at")
    conversationId        String? @map("conversation_id") @db.VarChar(255)
    workflowExecutionId   String? @map("workflow_execution_id") @db.VarChar(255)

    @@index([conversationId])
    @@index([email])
    @@index([status])
    @@map("leads")
}
